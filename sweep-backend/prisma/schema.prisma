generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id
  email     String   @unique
  // Public display name on the leaderboard. Null until the user picks one, in
  // which case they show as an anonymous "Sweeper #abcd" — a leaderboard must
  // never expose email addresses.
  username  String?  @unique
  createdAt DateTime @default(now())

  wallet           Wallet?
  trackedProducts  TrackedProduct[]
  transactions     Transaction[]
  budgetEntries    BudgetEntry[]
  budgetLimits     BudgetLimit[]
  savedSearches    SavedSearch[]
  searchHistory    SearchHistory[]
  promoRedemptions PromoCodeRedemption[]
  pushTokens       PushToken[]
  notifications    Notification[]
  dealsFound       Deal[]                @relation("DealFinder")
  lists            List[]
  cartItems        CartItem[]
}

// One row per device a user has granted notification permission on. A user can
// have several (phone + tablet), and a token can migrate between users if a
// device is handed over — hence the unique on token rather than on userId.
model PushToken {
  id         String   @id @default(uuid())
  token      String   @unique // ExponentPushToken[...]
  platform   String? // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Wallet {
  id            String    @id @default(uuid())
  tier          String    @default("free") // "free" | "pro" | "ultimate"
  tierExpiresAt DateTime?

  // A promo grant lives in its own two columns rather than sharing `tier`.
  //
  // Sharing looked simpler and is a trap: a paying Pro subscriber who redeems
  // a 14-day Ultimate code would have their paid tier overwritten, and drop to
  // FREE when the promo lapsed — still paying, silently downgraded. Kept apart,
  // effectiveTier() just takes whichever of the two is better right now, and
  // neither can damage the other.
  promoTier          String? // "pro" | "ultimate", null when no grant
  promoExpiresAt     DateTime?
  xp                 Int       @default(0)
  searchesUsedToday  Int       @default(0)
  // Extra searches unlocked today by watching rewarded ads, on top of the
  // tier's base allowance. Resets on the same daily boundary.
  bonusSearchesToday Int       @default(0)
  searchesResetAt    DateTime  @default(now())

  // Fixed times of day this user's products are checked, as local hours (0-23).
  // Free tier picks 2 — that's what bounds scraping load predictably instead of
  // it scaling with signups. Pro/Ultimate ignore this and use a rolling
  // interval instead.
  // Manual "Check price now" budget. Free gets a daily count, Pro a cooldown
  // between checks, Ultimate neither — see TIER_LIMITS.
  manualChecksToday   Int       @default(0)
  manualChecksResetAt DateTime  @default(now())
  lastManualCheckAt   DateTime?

  // Product lookups — one enriched page about one product. Metered separately
  // from search because they are different actions and spending one shouldn't
  // consume the other.
  //
  // Named `sweeps*` because this counter used to meter "Sweep this deal",
  // which product lookup replaced. Kept rather than renamed: a column rename
  // is a migration plus a window where old and new backends disagree about a
  // live table, bought for nothing but a nicer name.
  sweepsUsedToday Int      @default(0)
  sweepsResetAt   DateTime @default(now())

  // Manual "check my radars now" budget. This is what makes the free tier's
  // radar bounded: nothing runs unless someone taps, and they can only tap so
  // many times a day.
  radarRefreshesToday   Int      @default(0)
  radarRefreshesResetAt DateTime @default(now())
  // New radars + keyword edits. Stops delete-and-recreate (or rename) churn
  // from turning a 1-radar allowance into an unlimited search box.
  radarChangesToday     Int      @default(0)
  radarChangesResetAt   DateTime @default(now())

  checkHours  Int[]    @default([9, 21])
  // Minute offset for the interval tiers, anchored to local midnight.
  // Pro (every 2h) with 35 => 00:35, 02:35, 04:35…
  // Ultimate (every 30m) with 5 => 00:05, 00:35, 01:05…
  checkMinute Int      @default(0)
  // IANA zone, so "9am" means 9am where the user is, and survives DST. Stored
  // rather than an offset because an offset goes stale twice a year.
  timezone    String   @default("UTC")
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// What the bell shows.
//
// Push notifications are fire-and-forget: they land on a lock screen, get
// swiped away, and are gone. Anyone who misses one — phone off, permission
// never granted, notification dismissed by accident — has no way to find out
// what they missed, which makes the whole feature feel unreliable even when
// it worked.
//
// So every alert is also written here. The push is the interruption; this is
// the record.
model Notification {
  id        String    @id @default(uuid())
  // "price-drop" | "radar-match" | "announcement". A string rather than an
  // enum so a new kind doesn't need a migration, and old clients that don't
  // recognise one can fall back on title and body, which every kind has.
  kind      String
  title     String
  body      String
  /**
   * Where tapping it should go, as an in-app path like "/lookup?productId=x".
   * Null for anything with nowhere to go, which the client renders as an
   * unclickable row rather than a dead tap.
   */
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Drives both the list (newest first) and the unread count.
  @@index([userId, createdAt])
}

// One row per unique product being tracked ANYWHERE in the app — shared
// across all users tracking the same item, so a single check refreshes
// the price for everyone at once (same principle as Fervor's odds polling).
model Product {
  id                String    @id @default(uuid())
  retailer          String // "amazon" | "walmart" | "target" | "bestbuy" | "ebay"
  retailerId        String // ASIN / item ID / SKU — however that retailer identifies it
  url               String
  title             String
  imageUrl          String?
  currentPrice      Int? // cents, null if not yet checked
  listPrice         Int? // cents — retailer's "was"/list price, when shown
  currency          String    @default("USD")
  availability      String? // free-text from the retailer, normalized where possible
  rating            Float?
  ratingCount       Int?
  // Marketplace seller feedback, kept separate from `rating` because 99.3%
  // positive feedback and 4.4 stars on a product are not the same claim.
  // eBay is the only source today. Added so the search cache can rebuild a
  // result faithfully rather than quietly dropping the seller half.
  sellerRating      Float?
  sellerRatingCount Int?
  lastCheckedAt     DateTime?
  // Outcome of the most recent check. Mirrors ScrapeCheck.status but kept here
  // so a stale/blocked product can be filtered without joining the log.
  lastStatus        String? // "success" | "failed" | "blocked"
  // Consecutive checks that came back at the same price. Drives adaptive
  // backoff: an item that hasn't moved in weeks doesn't need checking as often
  // as one that's actively changing. Lives on Product, not TrackedProduct,
  // because checks are shared — if it's stable, it's stable for everyone.
  unchangedChecks   Int       @default(0)
  createdAt         DateTime  @default(now())

  priceHistory  PriceHistory[]
  trackedBy     TrackedProduct[]
  scrapeChecks  ScrapeCheck[]
  deals         Deal[]
  listItems     ListItem[]
  cartItems     CartItem[]
  budgetEntries BudgetEntry[]

  @@unique([retailer, retailerId])
  @@index([retailer])
  // Drives the scheduler's "who is due for a check" query.
  @@index([lastCheckedAt])
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Int // cents
  checkedAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([productId, checkedAt])
}

// Join between a user and a product they're tracking — per-user settings
// (custom threshold, notification state) live here, not on Product.
model TrackedProduct {
  id              String    @id @default(uuid())
  customThreshold Int? // cents — only notify below this (Pro and above)
  addedAt         DateTime  @default(now())
  lastNotifiedAt  DateTime?
  // What it cost when this user started watching, in cents. Stored rather than
  // derived: the shared Product row is updated in place, and PriceHistory only
  // records CHANGES — so a product that never moved has no history point at
  // the moment this user started, and "since you started" would be unanswerable.
  priceAtTracking Int?

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
  @@index([userId])
}

// Every price-check attempt writes one row here, success or not. This is the
// raw material for scraper health monitoring — a retailer changing its page
// structure shows up as a failure-rate spike, not as silent staleness.
model ScrapeCheck {
  id         String   @id @default(uuid())
  retailer   String
  status     String // "success" | "failed" | "blocked"
  // Truncated response body or error message, kept so the alert email can show
  // WHY it broke (structure change vs. actively blocked vs. timeout) without
  // needing to re-run the scrape to find out.
  detail     String?
  durationMs Int?
  checkedAt  DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@index([retailer, checkedAt])
  // Time alone, without a retailer. The composite index above leads on
  // retailer, so anything asking "what happened in the last N days" across all
  // stores — the admin trend, the health sweep — cannot use it and falls back
  // to scanning every check ever recorded.
  @@index([checkedAt])
}

// Tracks when we last alerted about a given retailer, so a sustained outage
// sends one email instead of one per failed check.
model ScraperAlert {
  id          String    @id @default(uuid())
  retailer    String    @unique
  lastAlertAt DateTime  @default(now())
  resolvedAt  DateTime?
}

// Guests have no User row, so their 1-search-per-day cap is keyed by a device
// ID generated on the client. Server-side so the client can't reset it by
// clearing state — reinstalling gets you one more search, and that's an
// acceptable ceiling for a free anonymous tier.
// A daily search ceiling per network, for guests only.
//
// GuestQuota is keyed on a device id the client sends, which anyone can rotate
// — so on its own it caps nothing. This is the durable backstop: it survives
// restarts (unlike an in-memory rate limiter) and it doesn't care what header
// you send.
//
// The IP is stored hashed. We need to count requests from a network, not to
// keep a record of who was on it.
model IpQuota {
  id                String   @id @default(uuid())
  ipHash            String   @unique
  searchesUsedToday Int      @default(0)
  searchesResetAt   DateTime @default(now())
  createdAt         DateTime @default(now())
}

// One row per (keyword, retailer) search we've already paid for.
//
// Stores WHICH PRODUCTS matched, not what they cost. Prices live on Product
// and are refreshed by scheduled checks and by anyone looking a product up, so
// rebuilding a cached search reads today's prices rather than replaying the
// ones that were current when the search ran. The expensive part of a search
// is discovering the matches; that is the part worth keeping.
// A search someone can reopen without paying for it again.
//
// Distinct from SearchCache, which is shared, per-retailer and expires in hours
// because it exists to stop us buying the same answer twice. This is per person,
// permanent up to their tier's cap, and exists so "what was that thing I looked
// at yesterday" doesn't cost a search.
//
// Only product ids are kept. Prices are read live from the Product rows on the
// way out, so reopening a week-old search shows this week's prices rather than a
// snapshot that has quietly gone wrong — which is the whole point of an app that
// tracks prices.
model SearchHistory {
  id         String   @id @default(uuid())
  // Normalized the same way SearchCache normalizes, so searching "AirPods  Pro"
  // and "airpods pro" doesn't leave two entries that look identical.
  keyword    String
  // In the order they were shown. Relevance order is part of the result.
  productIds String[]
  // How many stores answered, so the list can say what it was without
  // rebuilding the whole result set.
  storeCount Int      @default(0)
  searchedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Searching the same thing again moves the existing entry rather than filling
  // the list with duplicates of one keyword.
  @@unique([userId, keyword])
  // Drives the list, newest first, and the prune that enforces the tier cap.
  @@index([userId, searchedAt])
}

model SearchCache {
  id         String   @id @default(uuid())
  // Normalized: lowercased, trimmed, whitespace collapsed. "AirPods  Pro" and
  // "airpods pro" are the same question and should not be paid for twice.
  keyword    String
  retailer   String
  // Product ids, in the order the retailer returned them. Relevance order is
  // part of what we paid for.
  productIds String[]
  // How many results were asked for. A cache filled by a request for 4 can't
  // answer a request for 8, so this is checked before the entry is used.
  limit      Int
  fetchedAt  DateTime @default(now())

  @@unique([keyword, retailer])
  @@index([fetchedAt])
}

// The basket: what someone intends to buy, across every store at once.
//
// Deliberately distinct from List. A list is a wishlist — long-lived,
// shareable, often for somebody else. A cart is this week's shopping, one per
// person, and it exists to be emptied.
//
// priceAtAdd is the part no shop's own basket can do: it records what the item
// cost when it went in, so the cart can say "this has dropped £12 since you
// added it" — or that it has gone up, which is the more useful warning.
model CartItem {
  id         String   @id @default(uuid())
  quantity   Int      @default(1)
  // Cents, at the moment it was added. Null when the product had no price
  // then, which is rare but shouldn't block adding it.
  priceAtAdd Int?
  addedAt    DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // One row per product. Adding the same thing twice raises the quantity
  // rather than making a second line, which is what every basket does.
  @@unique([userId, productId])
  @@index([userId, addedAt])
}

model GuestQuota {
  id                String   @id @default(uuid())
  deviceId          String   @unique
  searchesUsedToday Int      @default(0)
  searchesResetAt   DateTime @default(now())
  // Product lookups, on their own counter for the same reason accounts have
  // one: reading product pages and searching are different actions, and
  // spending one shouldn't consume the other. Additive with defaults, so a
  // backend running the previous schema simply ignores these.
  lookupsUsedToday  Int      @default(0)
  lookupsResetAt    DateTime @default(now())
  createdAt         DateTime @default(now())
}

// One row per verified rewarded-ad completion. Exists purely to stop replays:
// AdMob can retry a callback, and without a uniqueness check on transactionId
// the same ad view could be redeemed repeatedly for free searches.
model AdReward {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userId        String
  amount        Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// A price drop good enough to show the whole app. Written by the scheduler
// when a tracked item falls far enough below its own historical average.
//
// `finderUserId` is whoever tracked the product FIRST — with the shared cache,
// many people watch the same item, and the one who spotted it before everyone
// else is the one worth crediting.
model Deal {
  id                  String   @id @default(uuid())
  previousPrice       Int // cents
  newPrice            Int // cents
  percentBelowAverage Int
  averagePrice        Int // cents, what "normal" was at the time
  createdAt           DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Nullable so a deal survives its finder deleting their account.
  finder       User?   @relation("DealFinder", fields: [finderUserId], references: [id], onDelete: SetNull)
  finderUserId String?

  @@index([createdAt])
  @@index([productId, createdAt])
}

// A gift list or wishlist. Shareable by public link — that's the growth loop:
// every shared list puts Sweep in front of someone who's never heard of it.
model List {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Random, unguessable, and separate from the id so a list can be unshared by
  // rotating it without breaking the list itself.
  shareToken  String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  items ListItem[]

  @@index([userId])
}

// A product on a list. Note this does NOT imply the product is price-tracked:
// list items are capped separately precisely because every tracked item costs
// real scraping, and a 100-item wishlist shouldn't quietly become 100 tracked
// products.
model ListItem {
  id      String   @id @default(uuid())
  note    String?
  addedAt DateTime @default(now())
  // Marked off by the list owner, or by whoever they shared it with.
  claimed Boolean  @default(false)

  list      List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([listId, productId])
  @@index([listId])
}

model BudgetEntry {
  id          String   @id @default(uuid())
  amount      Int // cents
  category    String
  description String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Set when the entry came from "I bought this" on a tracked product, which
  // is what makes this a shopping budget rather than a generic one: the row
  // remembers the item, so spending can be traced back to a real product.
  // SetNull rather than Cascade — deleting a cached product must never erase
  // someone's spending record.
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  @@index([userId, spentAt])
}

// A spending cap. An empty `category` is the overall monthly budget, which
// every tier gets; a named category is a per-category cap, which is a paid
// perk. The API speaks `null` for overall and converts at the edge.
//
// Empty string rather than NULL on purpose: Postgres treats NULLs as distinct
// in a unique index, so `@@unique([userId, category])` would happily allow two
// overall budgets per user. A sentinel makes the constraint actually hold.
//
// Deliberately not per-month rows: a budget is a standing intention, not a
// value you re-enter every month. Changing it changes it going forward.
// A standing "tell me when anything matches this" search.
//
// Tracking watches a URL you already found; a radar watches for something you
// haven't. That's the gap it fills, and it's why the keyword matters more than
// any particular listing.
//
// Deliberately stores the cheapest match we've already reported. Without it,
// every run re-reports the same $179 listing forever and the alerts become
// noise people turn off.
model SavedSearch {
  id          String   @id @default(uuid())
  keyword     String
  /**
   * Cents. Null means "tell me about anything notable", not "never alert".
   */
  targetPrice Int?
  createdAt   DateTime @default(now())

  lastCheckedAt   DateTime?
  nextCheckAt     DateTime  @default(now())
  /**
   * Feeds the same adaptive backoff that tracked products use.
   */
  unchangedChecks Int       @default(0)

  /**
   * Cheapest price we've already told this user about, so we don't repeat it.
   */
  lastBestPrice  Int?
  lastMatchAt    DateTime?
  lastNotifiedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([nextCheckAt])
}

model BudgetLimit {
  id        String   @id @default(uuid())
  amount    Int // cents
  category  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, category])
}

// XP ledger. Every award is a row, so a user's total is reconstructible and
// an anti-farming cooldown is just a query against recent rows rather than
// extra state to keep in sync.
model Transaction {
  id        String   @id @default(uuid())
  xpChange  Int
  reason    String // "deal_found" | "first_track" | "milestone"
  // Which product earned it, when applicable. Drives the per-product cooldown
  // that stops someone farming XP off one item bouncing in price.
  productId String?
  // Human-readable detail for the activity feed ("32% below average").
  detail    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([userId, productId, createdAt])
  @@index([createdAt])
}

// Promo codes YOU create and share (e.g. while creating content) — one
// directional: you issue it, someone redeems it for free Pro/Ultimate time.
model PromoCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  grantsTier         String // "pro" | "ultimate"
  grantsDurationDays Int // e.g. 7 for a week free
  maxRedemptions     Int? // null = unlimited
  timesRedeemed      Int       @default(0)
  expiresAt          DateTime? // code itself stops working after this date, if set
  createdAt          DateTime  @default(now())

  redemptions PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id         String   @id @default(uuid())
  redeemedAt DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  userId      String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId String

  @@unique([userId, promoCodeId]) // can't redeem the same code twice
}

/// One row per day, per page, per referrer — not one row per visit.
///
/// Deliberately aggregate. There is no IP, no cookie, no session and no
/// fingerprint here, so it can answer "how many visits on Tuesday, and how
/// many came from Reddit" and it cannot answer "did this person come back".
/// That is the trade, made on purpose: the landing page this counts says the
/// app has no data to sell, and the honest version of that is having none.
///
/// It also means the table grows with days and pages rather than with
/// traffic, so a good week costs a handful of rows instead of thousands.
model SiteVisit {
  id       String   @id @default(uuid())
  /// Midnight UTC of the day being counted.
  day      DateTime @db.Date
  /// Pathname only, query strings dropped — those carry campaign tags and,
  /// occasionally, whatever somebody pasted into a url.
  path     String
  /// Host only, never the full referring url, for the same reason.
  /// "direct" when there is no referrer.
  referrer String
  count    Int      @default(0)

  /// One row per combination, so recording a visit is an upsert.
  @@unique([day, path, referrer])
  @@index([day])
}

/// How much of each paid scraping provider's allowance is gone.
///
/// Counted at the moment a billed request is made, not from ScrapeCheck. The
/// check log only covers some paths (a search leg, a lookup, "Sweep this deal"
/// all bill without writing one), and against the providers' own dashboards it
/// read less than half the real figure. An alert built on it would fire after
/// the credits were already gone.
///
/// Drift is still possible, so `used` can be overwritten from the dashboard
/// with whatever the provider itself says.
model ProviderCredit {
  /// "decodo" or "brightdata".
  provider     String    @id
  /// "total" for an allowance that never refills, "2026-09" for a monthly one.
  /// A new month resets `used` and `alertedLevel` on the first request.
  period       String
  used         Int       @default(0)
  /// Null falls back to the known free-tier allowance.
  allowance    Int?
  /// The highest threshold (70, 90, 100) already emailed this period, so each
  /// one sends once rather than on every request past it.
  alertedLevel Int       @default(0)
  /// When `used` was last corrected from the provider's own number.
  syncedAt     DateTime?
  updatedAt    DateTime  @updatedAt
}

/// Billed requests per provider per day. Only here to answer "how fast is it
/// going", which is what turns a percentage into a date.
model ProviderCreditDay {
  id       String   @id @default(uuid())
  provider String
  day      DateTime @db.Date
  count    Int      @default(0)

  @@unique([provider, day])
}
